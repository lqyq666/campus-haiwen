# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# OpenAI-compatible language model endpoint
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4.1-mini

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Local Docker default; replace for hosted PostgreSQL
POSTGRES_URL=postgresql://haiwen:haiwen@localhost:5433/haiwen
# Optional explicit test database override.
TEST_DATABASE_URL=
SCHOOL_DATA_SOURCE=postgres
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=

# Internal blind-review workbench. Use a long random value; never expose it to students.
CALIBRATION_ADMIN_KEY=
CAMPUS_CHANNEL_API_KEY=

# https://vercel.com/docs/redis
REDIS_URL=****

# Feishu CRM projection. Keep disabled until the Base and application are configured.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_LEADS_TABLE_ID=
FEISHU_EVENTS_TABLE_ID=
FEISHU_NOTIFY_ENABLED=false
FEISHU_NOTIFY_RECEIVE_ID=
FEISHU_NOTIFY_RECEIVE_ID_TYPE=
